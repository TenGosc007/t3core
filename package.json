{
  "name": "t3core",
  "version": "1.6.0",
  "description": "Reusable TypeScript core library for Tic Tac Toe games",
  "scripts": {
    "build": "rm -rf dist && tsup",
    "build:watch": "tsup --watch",
    "prepack": "yarn build",
    "package:check": "node scripts/check-package.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage --run",
    "lint": "eslint src scripts \"*.{js,mjs,cjs,ts,mts,cts}\"",
    "commitlint": "commitlint",
    "commitlint:pr": "commitlint --config commitlint-pr.config.mjs",
    "hooks:install": "lefthook install",
    "ts:check": "tsc --noEmit",
    "fallow": "fallow health --coverage coverage/coverage-final.json",
    "release": "release-it",
    "release:check": "yarn lint && yarn ts:check && yarn test:coverage && yarn fallow && yarn package:check",
    "release:preview": "release-it --dry-run"
  },
  "keywords": [
    "tic-tac-toe",
    "game",
    "typescript",
    "nodejs"
  ],
  "author": "tengosc",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TenGosc007/t3core.git"
  },
  "bugs": {
    "url": "https://github.com/TenGosc007/t3core/issues"
  },
  "homepage": "https://github.com/TenGosc007/t3core#readme",
  "type": "commonjs",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "fallow": "^2.87.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "lefthook": "^2.2.2",
    "release-it": "^21.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  }
}
